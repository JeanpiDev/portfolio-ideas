---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Playground from './Playground.astro';
import Experience from './Experience.astro';
import Footer from './Footer.astro';
import AnswerComponent from './AnswerComponent.astro';
import { pieces, projects, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
  <header style="background-image: radial-gradient(900px 520px at 15% -10%, var(--glow), transparent 70%)">
    <Nav lang={lang} />
  </header>
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Playground lang={lang} />
    <Experience lang={lang} />
  </main>
  <Footer lang={lang} />

  <!-- Components the assistant may show. It only sends an id; markup comes from here. -->
  {projects.map((p) => (
    <template id={`tpl-project-${p.id}`}>
      <AnswerComponent name="project" id={p.id} lang={lang} />
    </template>
  ))}
  {pieces.map((p) => (
    <template id={`tpl-piece-${p.id}`}>
      <AnswerComponent name="piece" id={p.id} lang={lang} />
    </template>
  ))}
</Base>
