---
import { profile, type Lang } from '../data/profile';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  ['#projects', t('nav.projects')],
  ['#playground', t('nav.playground')],
  ['#experience', t('nav.experience')],
];
---

<nav aria-label={t('nav.label')} class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 py-4">
  <a href={`/${lang}/`} class="display grow text-xl no-underline">{profile.name}</a>
  <div class="flex flex-wrap items-center gap-1">
    <ul class="m-0 flex list-none flex-wrap p-0">
      {
        links.map(([href, label]) => (
          <li>
            <a href={href} class="flex min-h-11 items-center px-3 text-[15px] text-muted no-underline hover:text-text">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="flex items-center px-1 font-mono text-[13px] text-faint" role="group" aria-label={t('nav.lang')}>
      <a
        href="/en/"
        lang="en"
        hreflang="en"
        aria-current={lang === 'en' ? 'page' : undefined}
        class:list={['flex min-h-11 min-w-11 items-center justify-center', lang === 'en' ? 'text-text underline' : 'text-muted no-underline']}
        >EN</a
      >
      <span aria-hidden="true">/</span>
      <a
        href="/es/"
        lang="es"
        hreflang="es"
        aria-current={lang === 'es' ? 'page' : undefined}
        class:list={['flex min-h-11 min-w-11 items-center justify-center', lang === 'es' ? 'text-text underline' : 'text-muted no-underline']}
        >ES</a
      >
    </span>
    <button
      type="button"
      class="theme-toggle flex h-11 w-11 items-center justify-center rounded-full border border-border-strong bg-transparent"
      data-requires-js
      data-to-light={t('theme.toLight')}
      data-to-dark={t('theme.toDark')}
      aria-label={t('theme.toLight')}
    >
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
        ><path d="M20 14A8 8 0 1 1 10 4a6 6 0 0 0 10 10z"></path></svg
      >
    </button>
    <a href="#contact" class="btn btn-ink ml-2">{t('nav.contact')}</a>
  </div>
</nav>

<script>
  // Theme toggle: `.light` on <html>, persisted in localStorage (applied pre-paint in Base.astro).
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (btn) {
    const sync = () => {
      const light = document.documentElement.classList.contains('light');
      btn.setAttribute('aria-label', light ? btn.dataset.toDark! : btn.dataset.toLight!);
    };
    sync();
    btn.addEventListener('click', () => {
      const light = document.documentElement.classList.toggle('light');
      try {
        localStorage.setItem('theme', light ? 'light' : 'dark');
      } catch {}
      sync();
    });
  }
</script>
