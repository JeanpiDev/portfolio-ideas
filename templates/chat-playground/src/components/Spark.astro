---
// The AI mark. Every AI element carries it, so the accent color is never the only signal.
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: cls = '' } = Astro.props;
---

<svg class={`spark ${cls}`} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d="M12 2l2.2 6.6L21 11l-6.8 2.3L12 20l-2.2-6.7L3 11l6.8-2.4z"></path>
</svg>
