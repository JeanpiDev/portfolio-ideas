---
/** Small drawn project thumbnails (no images). Decorative. */
interface Props {
  kind: 'slider' | 'queue' | 'map' | 'assistant';
}
const { kind } = Astro.props;
---

<svg class="thumb" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="70" height="70" rx="3" fill="#fff" stroke="#7f9db9"></rect>
  <rect x="1" y="1" width="70" height="10" rx="3" fill="#2d5ac4"></rect>
  {
    kind === 'slider' && (
      <g>
        <rect x="8" y="20" width="34" height="5" fill="#cfd6e4" />
        <rect x="8" y="34" width="56" height="4" rx="2" fill="#cfd6e4" />
        <rect x="8" y="34" width="34" height="4" rx="2" fill="#3f9a3f" />
        <circle cx="42" cy="36" r="5" fill="#fff" stroke="#2d5ac4" stroke-width="2" />
        <rect x="8" y="48" width="56" height="14" fill="#ece9d8" stroke="#919b9c" />
        <rect x="12" y="52" width="26" height="6" fill="#555" />
      </g>
    )
  }
  {
    kind === 'queue' && (
      <g>
        {[18, 30, 42, 54].map((y, i) => (
          <g>
            <circle cx="12" cy={y + 3} r="3" fill={['#3f9a3f', '#e8b22d', '#3f9a3f', '#c4402a'][i]} />
            <rect x="19" y={y} width={[40, 30, 36, 24][i]} height="6" fill="#cfd6e4" />
          </g>
        ))}
      </g>
    )
  }
  {
    kind === 'map' && (
      <g>
        <rect x="4" y="13" width="64" height="55" fill="#d9ead0" />
        <path d="M4 40c14-6 22 6 36-2s20-4 28-8" stroke="#8fb8e8" stroke-width="5" fill="none" />
        <path d="M20 13v55M4 28h64" stroke="#fff" stroke-width="3" />
        <path d="M44 30a6 6 0 1 1 12 0c0 5-6 10-6 10s-6-5-6-10z" fill="#c4402a" />
        <circle cx="50" cy="30" r="2" fill="#fff" />
        <circle cx="24" cy="52" r="5" fill="#2d5ac4" />
      </g>
    )
  }
  {
    kind === 'assistant' && (
      <g>
        <rect x="8" y="18" width="40" height="18" rx="5" fill="#ffffe1" stroke="#000" />
        <path d="M18 36l-4 6 9-6z" fill="#ffffe1" stroke="#000" />
        <path d="M14 24h26M14 30h18" stroke="#555" stroke-width="2" />
        <path d="M56 44l1.8 5.4L63 51l-5.2 1.8L56 58l-1.8-5.2L49 51l5.2-1.6z" fill="#000" />
        <rect x="8" y="50" width="36" height="12" fill="#fff" stroke="#7f9db9" />
      </g>
    )
  }
</svg>
