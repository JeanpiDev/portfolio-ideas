---
/**
 * Shared gradients for the glossy icons (rendered once per page, never display:none, so
 * every <Icon> can reference them even inside hidden menus).
 */
---

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    <linearGradient id="ig-folder-back" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6d36b"></stop><stop offset="1" stop-color="#d79a1c"></stop>
    </linearGradient>
    <linearGradient id="ig-folder-front" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff4c2"></stop><stop offset="0.35" stop-color="#fbd66a"></stop><stop offset="1" stop-color="#e9a923"></stop>
    </linearGradient>
    <linearGradient id="ig-paper" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop><stop offset="1" stop-color="#d9e4f5"></stop>
    </linearGradient>
    <linearGradient id="ig-brown" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d79552"></stop><stop offset="0.5" stop-color="#a8642a"></stop><stop offset="1" stop-color="#7a4517"></stop>
    </linearGradient>
    <linearGradient id="ig-envelope" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop><stop offset="1" stop-color="#e6ddc4"></stop>
    </linearGradient>
    <linearGradient id="ig-metal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4f5f8"></stop><stop offset="0.5" stop-color="#c7cbd6"></stop><stop offset="1" stop-color="#8e94a3"></stop>
    </linearGradient>
    <linearGradient id="ig-bin" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#9fb8d8"></stop><stop offset="0.45" stop-color="#eef4fb"></stop><stop offset="1" stop-color="#7f9cc4"></stop>
    </linearGradient>
    <radialGradient id="ig-green" cx="0.35" cy="0.3" r="0.75">
      <stop offset="0" stop-color="#b9f08a"></stop><stop offset="0.45" stop-color="#4fb43a"></stop><stop offset="1" stop-color="#21781c"></stop>
    </radialGradient>
    <radialGradient id="ig-blue" cx="0.35" cy="0.3" r="0.75">
      <stop offset="0" stop-color="#a9d4ff"></stop><stop offset="0.5" stop-color="#2f7be8"></stop><stop offset="1" stop-color="#103f9e"></stop>
    </radialGradient>
    <radialGradient id="ig-grey" cx="0.35" cy="0.3" r="0.75">
      <stop offset="0" stop-color="#f2f3f6"></stop><stop offset="0.5" stop-color="#b6bac6"></stop><stop offset="1" stop-color="#7d8291"></stop>
    </radialGradient>
    <linearGradient id="ig-orange" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd27a"></stop><stop offset="0.5" stop-color="#f39a1e"></stop><stop offset="1" stop-color="#c8650a"></stop>
    </linearGradient>
    <linearGradient id="ig-red" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffa08a"></stop><stop offset="0.5" stop-color="#e2502c"></stop><stop offset="1" stop-color="#a82a10"></stop>
    </linearGradient>
    <linearGradient id="ig-screen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3b82f0"></stop><stop offset="0.6" stop-color="#2a63d0"></stop><stop offset="0.6" stop-color="#53a83a"></stop><stop offset="1" stop-color="#2f7a22"></stop>
    </linearGradient>
    <radialGradient id="ig-glass" cx="0.4" cy="0.35" r="0.7">
      <stop offset="0" stop-color="#ffffff"></stop><stop offset="1" stop-color="#9cc8f2"></stop>
    </radialGradient>
  </defs>
</svg>
