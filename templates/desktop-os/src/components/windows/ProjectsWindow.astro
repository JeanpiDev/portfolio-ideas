---
/** Projects: an explorer-style window (menu bar, toolbar, address bar, task pane, tiles). */
import Window from '../Window.astro';
import Icon from '../Icon.astro';
import ProjectThumb from '../ProjectThumb.astro';
import { profile, type Lang, type Area } from '../../data/profile';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const areas: Area[] = ['frontend', 'uiux', 'backend', 'ai'];
const count = profile.projects.length;
---

<Window id="projects" lang={lang} icon="folder" w={720} x={0.13} y={0.04}>
  <Fragment slot="chrome">
    <div class="xp-menubar" aria-hidden="true">
      <span>{t('explorer.menu.file')}</span><span>{t('explorer.menu.edit')}</span><span>{t('explorer.menu.view')}</span><span>{t('explorer.menu.help')}</span>
    </div>
    <div class="xp-toolbar">
      <span class="tool-btn" aria-disabled="true" aria-hidden="true"><Icon name="back" /></span>
      <span class="tool-btn" aria-disabled="true" aria-hidden="true"><Icon name="forward" /></span>
      <span class="tool-btn" aria-disabled="true" aria-hidden="true"><Icon name="up" /></span>
      <span class="tool-sep" aria-hidden="true"></span>
      <button type="button" class="tool-btn" data-ai-focus>
        <Icon name="search" />
        <Icon name="spark" class="spark" />
        {t('explorer.search')}
      </button>
    </div>
    <div class="xp-address" aria-hidden="true">
      <span>{t('explorer.address')}</span>
      <span class="addr"><Icon name="folder" class="w-4 h-4" />{`\\\\${profile.firstName.toLowerCase()}\\projects`}</span>
    </div>
  </Fragment>

  <div class="explorer">
    <aside class="task-pane" aria-label={t('explorer.tasks')}>
      <div class="pane-box">
        <h3>{t('explorer.tasks')}</h3>
        <ul>
          <li>
            <a href={`mailto:${profile.email}`}><Icon name="mail" />{t('explorer.emailTask')}</a>
          </li>
          <li>
            <button type="button" data-ai-focus><Icon name="spark" class="spark" />{t('explorer.askTask')}</button>
          </li>
        </ul>
      </div>
      <div class="pane-box">
        <h3>{t('explorer.places')}</h3>
        <ul>
          <li><a href="#win-about" data-open="about"><Icon name="notepad" />{t('win.about')}</a></li>
          <li><a href="#win-experience" data-open="experience"><Icon name="briefcase" />{t('win.experience')}</a></li>
          <li><a href="#win-resume" data-open="resume"><Icon name="resume" />{t('win.resume')}</a></li>
          <li><a href="#win-contact" data-open="contact"><Icon name="mail" />{t('win.contact')}</a></li>
        </ul>
      </div>
      <div class="pane-box">
        <h3>{t('explorer.details')}</h3>
        <p>{profile.name} · {profile.role[lang]}</p>
      </div>
    </aside>

    <div>
      <div class="chips js-only" role="group" aria-label={t('explorer.filter')} data-chips>
        <span class="chips-label" aria-hidden="true">{t('explorer.filter')}:</span>
        <button type="button" class="xp-btn" aria-pressed="true" data-filter="all">{t('explorer.all')}</button>
        {
          areas.map((a) => (
            <button type="button" class="xp-btn" aria-pressed="false" data-filter={a}>
              {t(`area.${a}`)}
            </button>
          ))
        }
      </div>
      <ul class="tiles" data-tiles>
        {
          profile.projects.map((p) => (
            <li class="tile" id={`project-${p.id}`} data-areas={p.areas.join(' ')} tabindex="-1">
              <ProjectThumb kind={p.preview} />
              <div>
                <h3>{p.name[lang]}</h3>
                <span class="kind">{p.kind[lang]}</span>
                <p>{p.description[lang]}</p>
                <ul class="tags">
                  {p.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {(p.repo || p.live) && (
                  <div class="links">
                    {p.repo && (
                      <a href={p.repo} rel="noopener">
                        {t('explorer.repo')}
                        <span class="sr-only"> — {p.name[lang]}</span>
                      </a>
                    )}
                    {p.live && (
                      <a href={p.live} rel="noopener">
                        {t('explorer.live')}
                        <span class="sr-only"> — {p.name[lang]}</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Fragment slot="status">
    <span data-count aria-live="polite">{t('explorer.items', { n: count })}</span>
    <span>{t('win.keys')}</span>
  </Fragment>
</Window>

<script>
  import { strings } from '../../scripts/client';

  // Filter chips (progressive enhancement: all projects are visible without JS).
  document.querySelectorAll<HTMLElement>('[data-chips]').forEach((group) => {
    const win = group.closest('.win')!;
    const tiles = [...win.querySelectorAll<HTMLElement>('[data-tiles] > .tile')];
    const count = win.querySelector<HTMLElement>('[data-count]');
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const f = btn.dataset.filter!;
      group.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      tiles.forEach((tile) => {
        const show = f === 'all' || (tile.dataset.areas ?? '').split(' ').includes(f);
        tile.hidden = !show;
        if (show) n++;
      });
      if (count) {
        const s = strings();
        count.textContent = n === 1 ? s['explorer.item'] : s['explorer.items'].replace('{n}', String(n));
      }
    });
  });
</script>
