---
/**
 * Original inline-SVG icons drawn in a glossy early-2000s style. Gradients live in
 * IconDefs.astro (rendered once per page). Icons are decorative (aria-hidden) unless a
 * `label` is passed. Add new icons to the `icons` map.
 */
interface Props {
  name: keyof typeof icons;
  class?: string;
  label?: string;
}

const hl = (d: string) => `<path d="${d}" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="1"/>`;

const icons = {
  logo: `<circle cx="16" cy="16" r="14" fill="url(#ig-blue)" stroke="#fff" stroke-width="2"/><path d="M9.5 23l6.5-15 6.5 15h-3.4l-1.2-3h-3.8l-1.2 3z" fill="#fff"/><path d="M14.6 17h2.8L16 13.4z" fill="#2f7be8"/><path d="M5 11.5c4-6 13-7.5 20-3.5" stroke="#7cd84a" stroke-width="2.6" fill="none" stroke-linecap="round"/>`,
  folder: `<path d="M2 7.5h10.5l2.5 2.5H30v16.5H2z" fill="url(#ig-folder-back)" stroke="#b07c12" stroke-width=".8"/><path d="M1.5 12.5h29L29 27H3z" fill="url(#ig-folder-front)" stroke="#b07c12" stroke-width=".8"/>${hl('M3 13.8h26')}`,
  notepad: `<path d="M6 2.5h15l5.5 5.5v21.5H6z" fill="url(#ig-paper)" stroke="#6a7a99"/><path d="M21 2.5V8h5.5z" fill="#c7d3ea" stroke="#6a7a99" stroke-linejoin="round"/><path d="M9.5 12h13M9.5 15.5h13M9.5 19h13M9.5 22.5h9" stroke="#4a78d0" stroke-width="1.4"/>`,
  briefcase: `<path d="M12 9V6.5a1.5 1.5 0 0 1 1.5-1.5h5A1.5 1.5 0 0 1 20 6.5V9" fill="none" stroke="#5a320e" stroke-width="2"/><rect x="2.5" y="9" width="27" height="18" rx="2.5" fill="url(#ig-brown)" stroke="#5a320e"/><path d="M2.5 15.5h27" stroke="#5a320e"/><rect x="13.5" y="13.5" width="5" height="4.5" rx="1" fill="#f7d26a" stroke="#5a320e" stroke-width=".8"/>${hl('M4.5 10.5h23')}`,
  resume: `<path d="M6 2.5h15l5.5 5.5v21.5H6z" fill="url(#ig-paper)" stroke="#6a7a99"/><path d="M21 2.5V8h5.5z" fill="#c7d3ea" stroke="#6a7a99"/><circle cx="12" cy="11.5" r="3" fill="url(#ig-blue)"/><path d="M7.8 19c.8-3.6 7.6-3.6 8.4 0z" fill="url(#ig-blue)"/><path d="M18 10.5h5.5M18 13.5h5.5M9 22.5h14M9 25.5h10" stroke="#666" stroke-width="1.3"/>`,
  mail: `<rect x="2.5" y="7" width="27" height="19" rx="1.5" fill="url(#ig-envelope)" stroke="#7a6a45"/><path d="M3 8l13 10L29 8" fill="none" stroke="#7a6a45" stroke-width="1.2"/><path d="M3 25.5l10-8.5M29 25.5l-10-8.5" stroke="#a89770"/><rect x="22" y="9.5" width="5" height="5" fill="#d0342c"/>`,
  drive: `<path d="M3 15l4-8h18l4 8z" fill="#dfe2ea" stroke="#5b6170"/><rect x="3" y="15" width="26" height="9" rx="1.5" fill="url(#ig-metal)" stroke="#5b6170"/><circle cx="24.5" cy="19.5" r="1.6" fill="#4fd13a" stroke="#1d6b14" stroke-width=".6"/><path d="M6 19.5h12" stroke="#5b6170" stroke-width="1.4"/>`,
  archive: `<path d="M8 9h16l-1.6 19a2 2 0 0 1-2 1.8h-8.8a2 2 0 0 1-2-1.8z" fill="url(#ig-bin)" stroke="#3e5a84"/><rect x="6" y="5.5" width="20" height="4" rx="1.5" fill="url(#ig-bin)" stroke="#3e5a84"/><path d="M12 12l.6 14M16 12v14M20 12l-.6 14" stroke="#3e5a84" stroke-opacity=".6"/><rect x="11" y="14" width="10" height="7" fill="#fff" stroke="#6a7a99" stroke-width=".8" transform="rotate(-8 16 17)"/>`,
  computer: `<rect x="3" y="4" width="26" height="18" rx="2" fill="url(#ig-metal)" stroke="#5b6170"/><rect x="5.5" y="6.5" width="21" height="13" fill="url(#ig-screen)"/><path d="M11 27h10l-1.5-5h-7z" fill="url(#ig-metal)" stroke="#5b6170"/>`,
  desktop: `<rect x="3" y="5" width="26" height="18" rx="1.5" fill="url(#ig-screen)" stroke="#1a2d5c"/><path d="M12 27h8M16 23v4" stroke="#555" stroke-width="2"/>`,
  globe: `<circle cx="16" cy="16" r="12.5" fill="url(#ig-blue)"/><path d="M9 9.5c3 0 4 3 7 2s2 4 0 5-4 1-4 4-3 1-4-2 0-6 1-9z" fill="#5fc23a"/><path d="M20 20c2-1 4 0 5 2-1 2-3 4-5 4z" fill="#5fc23a"/><circle cx="16" cy="16" r="12.5" fill="none" stroke="#1d4f9c"/>`,
  palette: `<path d="M16 3C8 3 3 9 3 15c0 7 6 12 12 12 2 0 3-1 3-3s-2-3 0-4 3 0 6 0c3 0 5-3 5-6C29 8 23 3 16 3z" fill="url(#ig-envelope)" stroke="#8a6d2b"/><circle cx="9" cy="14" r="2.2" fill="#2d5ac4"/><circle cx="13" cy="9" r="2.2" fill="#3f9a3f"/><circle cx="20" cy="9" r="2.2" fill="#c4402a"/><circle cx="24" cy="15" r="2.2" fill="#9aa0ad"/>`,
  classic: `<path d="M6 2.5h20v27H6z" fill="url(#ig-paper)" stroke="#6a7a99"/><path d="M9.5 8h13M9.5 12h13M9.5 16h13M9.5 20h13M9.5 24h9" stroke="#333" stroke-width="1.4"/>`,
  search: `<circle cx="13" cy="13" r="8" fill="url(#ig-glass)" stroke="#2d5ac4" stroke-width="2.4"/><path d="M19 19l8 8" stroke="#6b4f1a" stroke-width="4.2" stroke-linecap="round"/>`,
  folders: `<path d="M8 9h7l2 2h12v14H8z" fill="url(#ig-folder-back)" stroke="#b07c12" stroke-width=".8"/><path d="M8 13h21l-1 12H8z" fill="url(#ig-folder-front)" stroke="#b07c12" stroke-width=".8"/><path d="M3 5v17h5M3 12h5" stroke="#555" stroke-width="1.2" fill="none" stroke-dasharray="1.5 1"/>`,
  views: `<rect x="3" y="4" width="11" height="11" fill="url(#ig-blue)" stroke="#1d4f9c"/><rect x="18" y="4" width="11" height="11" fill="url(#ig-folder-front)" stroke="#b07c12"/><rect x="3" y="18" width="11" height="11" fill="url(#ig-green)" stroke="#21781c"/><rect x="18" y="18" width="11" height="11" fill="url(#ig-grey)" stroke="#5b6170"/>`,
  back: `<circle cx="16" cy="16" r="13" fill="url(#ig-green)" stroke="#1d6b14"/><path d="M18.5 9l-7 7 7 7" stroke="#fff" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  forward: `<circle cx="16" cy="16" r="13" fill="url(#ig-green)" stroke="#1d6b14"/><path d="M13.5 9l7 7-7 7" stroke="#fff" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  up: `<path d="M2 9.5h10l2.5 2.5H30v15H2z" fill="url(#ig-folder-front)" stroke="#b07c12" stroke-width=".8"/><path d="M16 25v-9M11.5 20l4.5-4.5 4.5 4.5" stroke="#1d8a1d" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  go: `<rect x="3" y="3" width="26" height="26" rx="5" fill="url(#ig-green)" stroke="#1d6b14"/><path d="M8 16h14M16 9.5l6.5 6.5-6.5 6.5" stroke="#fff" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  arrow: `<circle cx="16" cy="16" r="12" fill="url(#ig-green)" stroke="#1d6b14"/><path d="M8.5 16h12M15.5 10.5l5.5 5.5-5.5 5.5" stroke="#fff" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  logoff: `<rect x="3" y="3" width="26" height="26" rx="6" fill="url(#ig-orange)" stroke="#fff" stroke-width="1.6"/><path d="M14 9H9v14h5" stroke="#fff" stroke-width="2.6" fill="none" stroke-linejoin="round"/><path d="M14 16h10M20 12l4 4-4 4" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  turnoff: `<rect x="3" y="3" width="26" height="26" rx="6" fill="url(#ig-red)" stroke="#fff" stroke-width="1.6"/><path d="M11.5 11a7 7 0 1 0 9 0" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round"/><path d="M16 7.5v8" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>`,
  motion: `<circle cx="16" cy="16" r="13" fill="url(#ig-grey)" stroke="#5b6170"/><path d="M6.5 16h5M6.5 12h7M6.5 20h7" stroke="#1d4f9c" stroke-width="1.8" stroke-linecap="round"/><circle cx="20" cy="16" r="5" fill="url(#ig-blue)" stroke="#1d4f9c"/>`,
  assistant: `<rect x="5" y="8" width="22" height="18" rx="7" fill="#ffffe1" stroke="#000" stroke-width="1.6"/><circle cx="12" cy="16" r="2" fill="#000"/><circle cx="20" cy="16" r="2" fill="#000"/><path d="M12 21q4 3 8 0" stroke="#000" stroke-width="1.6" fill="none" stroke-linecap="round"/><path d="M16 8V4" stroke="#000" stroke-width="1.6"/><circle cx="16" cy="3.5" r="1.8" fill="#000"/>`,
  spark: `<path d="M12 2l2.2 6.6L21 11l-6.8 2.3L12 20l-2.2-6.7L3 11l6.8-2.4z" fill="currentColor"/>`,
  print: `<rect x="8" y="3.5" width="16" height="9" fill="url(#ig-paper)" stroke="#555"/><rect x="2.5" y="11.5" width="27" height="12" rx="2.5" fill="url(#ig-metal)" stroke="#555"/><rect x="8" y="19" width="16" height="9.5" fill="#fff" stroke="#555"/><circle cx="25" cy="15.5" r="1.4" fill="#4fd13a"/>`,
  link: `<circle cx="16" cy="16" r="13" fill="url(#ig-glass)" stroke="#2d5ac4" stroke-width="1.6"/><path d="M13 19l6-6M11 17l-2 2a3 3 0 0 0 4 4l2-2M21 15l2-2a3 3 0 0 0-4-4l-2 2" stroke="#1d4f9c" stroke-width="2.2" fill="none" stroke-linecap="round"/>`,
  copy: `<rect x="9" y="9" width="16" height="19" fill="url(#ig-paper)" stroke="#555" stroke-width="1.2"/><path d="M6 23V5h14" fill="none" stroke="#555" stroke-width="1.2"/>`,
  info: `<circle cx="16" cy="16" r="13" fill="url(#ig-blue)" stroke="#103f9e"/><circle cx="16" cy="9.5" r="2.2" fill="#fff"/><path d="M16 14v10" stroke="#fff" stroke-width="3.2" stroke-linecap="round"/>`,
  chevronUp: `<path d="M4 9l4-4 4 4M4 13l4-4 4 4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  dropdown: `<path d="M4 6l4 4 4-4z" fill="currentColor"/>`,
  minimize: `<path d="M4 12h8" stroke="currentColor" stroke-width="3"/>`,
  maximize: `<rect x="2.5" y="2.5" width="11" height="10" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M2.5 4h11" stroke="currentColor" stroke-width="3"/>`,
  restore: `<rect x="2.5" y="5.5" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5.5 5.5v-3h8v8h-3" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
  close: `<path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>`,
} as const;

const small = ['spark', 'minimize', 'maximize', 'restore', 'close', 'chevronUp', 'dropdown'];
const viewBox = (n: string) => (n === 'spark' ? '0 0 24 24' : small.includes(n) ? '0 0 16 16' : '0 0 32 32');

const { name, class: className, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg class={className} viewBox={viewBox(name)} xmlns="http://www.w3.org/2000/svg" {...a11y} set:html={icons[name]} />
