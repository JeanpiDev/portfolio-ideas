# Optional. Without it, /api/chat runs in DEMO MODE (canned answers grounded in src/data/profile.ts).
# Get a key at https://console.anthropic.com/ — never commit a real key.
ANTHROPIC_API_KEY=

# Optional. Claude model used by the assistant. Defaults to claude-haiku-4-5 (fast and cheap).
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional. Public production URL, used for canonical and Open Graph URLs.
PUBLIC_SITE_URL=https://example.com
