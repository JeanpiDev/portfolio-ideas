# Optional. Without it the assistant runs in DEMO MODE: canned, grounded answers
# picked by keyword matching over src/data/profile.ts (no tokens spent).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5 (fast and cheap for short answers).
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional. Public site URL (used for canonical URLs). Defaults to http://localhost:4321.
PUBLIC_SITE_URL=
