---
/** Abstract, CSS-only project thumbnail (no image hotlinks). Decorative. */
import type { ProjectVisual } from '../data/profile';
interface Props { visual: ProjectVisual }
const { visual } = Astro.props;
---
<div class="thumb" aria-hidden="true">
  {visual === 'slider' && (
    <>
      <span class="bar" />
      <div class="row"><span class="blk" /><span class="blk w2" /></div>
      <div class="row" style="flex:0 0 10px"><span class="blk w2" style="background:var(--border-strong)" /><span class="blk" /></div>
    </>
  )}
  {visual === 'queue' && (
    <>
      <span class="bar" style="width:30%" />
      <div class="row"><span class="blk" /><span class="blk" /><span class="blk" /></div>
      <div class="row"><span class="blk w2" /><span class="blk" /></div>
    </>
  )}
  {visual === 'map' && (
    <div class="row">
      <span class="blk" style="flex:0 0 30%" />
      <span class="blk w2" style="background:repeating-linear-gradient(45deg,var(--border) 0 6px,var(--surface-2) 6px 12px)" />
    </div>
  )}
  {visual === 'chat' && (
    <>
      <span class="bar" style="width:60%" />
      <div class="row"><span class="blk ai" /><span class="blk w2" /></div>
      <span class="bar" style="width:35%;align-self:flex-end" />
    </>
  )}
</div>
