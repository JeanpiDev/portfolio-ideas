# Copy to `.env` and fill in what you need. Everything is optional.
# In Astro, anything exposed to the browser must start with PUBLIC_.

# Production URL (your domain). Drives sitemap, canonical/OG URLs and robots.txt.
PUBLIC_SITE_URL=https://example.com

# Contact form: free access key from https://web3forms.com
# Empty = the contact section only shows the mailto link.
PUBLIC_WEB3FORMS_KEY=

# AI assistant. SECRET, server only (no PUBLIC_ prefix).
# Empty = demo mode: canned, grounded answers picked from src/data/profile.ts.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5).
ANTHROPIC_MODEL=claude-haiku-4-5
