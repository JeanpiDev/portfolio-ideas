---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { useTranslations } from '../i18n/utils';

// Static 404 (served for every locale), so it shows both languages.
const en = useTranslations('en');
const es = useTranslations('es');
---

<Base title={`404 — ${profile.name}`} description={en('404.title')}>
  <section class="flex min-h-[80vh] items-center pt-24">
    <div class="container-page">
      <p class="animate-in font-mono text-sm text-[var(--muted)]">
        <span class="text-[var(--text)]">visitor@{profile.handle}</span>:~$ cd <span class="text-[var(--text)]">./this-page</span>
      </p>
      <p class="animate-in mt-2 font-mono text-sm text-[var(--muted)]" style="animation-delay:0.1s">
        bash: cd: <span class="text-[var(--text)]">404</span>: No such file or directory
      </p>

      <h1 class="animate-in mt-8 text-[clamp(4rem,18vw,10rem)] leading-none" style="animation-delay:0.2s">404</h1>

      <p class="animate-in mt-6 max-w-md text-lg text-[var(--muted)]" style="animation-delay:0.3s">
        {en('404.body')}<br />
        <span lang="es">{es('404.body')}</span>
      </p>

      <div class="animate-in mt-8 flex flex-wrap gap-3" style="animation-delay:0.4s">
        <a href="/en/" class="btn btn-primary"><Icon name="home" size={16} />{en('404.home')}</a>
        <a href="/es/" class="btn btn-ghost" lang="es">{es('404.home')}</a>
      </div>
    </div>
  </section>
</Base>
