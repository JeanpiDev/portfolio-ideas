---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { experience } from '../data/profile';
import TechBadge from './TechBadge.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="experience" class="scroll-mt-24 py-24">
  <div class="container-page">
    <p class="eyebrow reveal">02 — {t('nav.experience')}</p>
    <h2 class="section-title reveal">{t('experience.title')}</h2>

    <ol class="mt-12 space-y-12">
      {
        experience.map((item, i) => (
          <li
            id={`exp-${item.id}`}
            class="reveal relative scroll-mt-28 border-l border-[var(--border-strong)] pl-6 sm:pl-8"
            style={`transition-delay: ${i * 0.08}s`}
          >
            <span class="absolute -left-[6px] top-1.5 h-3 w-3 rounded-full border-2 border-[var(--text)] bg-[var(--bg)]" aria-hidden="true" />
            <p class="label-mono">{item.period[lang]}</p>
            <h3 class="mt-2 text-2xl sm:text-3xl">
              {item.role[lang]}
              <span class="text-[var(--muted)]"> · {item.company}</span>
            </h3>
            <p class="mt-3 text-[var(--muted)]">{item.summary[lang]}</p>
            <ul class="mt-4 space-y-2">
              {item.highlights[lang].map((h) => (
                <li class="flex gap-3 text-[var(--muted)]">
                  <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-[var(--faint)]" aria-hidden="true" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <TechBadge name={tag} />
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
