---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { SOCIALS } from '../config';
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear(); // build year
---

<footer class="mt-24 border-t border-[var(--border)] py-10">
  <div class="container-page flex flex-col items-center justify-between gap-4 sm:flex-row">
    <p class="font-mono text-xs text-[var(--faint)]">
      © {year} {profile.name}. {t('footer.rights')}
    </p>
    <div class="flex items-center gap-1">
      {
        SOCIALS.map((s) => (
          <a
            href={s.href}
            target={s.icon === 'mail' ? undefined : '_blank'}
            rel={s.icon === 'mail' ? undefined : 'noopener noreferrer'}
            class="icon-btn"
            aria-label={s.name}
          >
            <Icon name={s.icon} size={19} />
          </a>
        ))
      }
    </div>
    <p class="font-mono text-xs text-[var(--faint)]">{t('footer.builtWith')}</p>
  </div>
</footer>
